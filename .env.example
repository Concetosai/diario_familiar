# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter (alternativa seleccionable a Gemini)
# AI_PROVIDER: proveedor de IA por defecto. Valores: "gemini" | "openrouter"
# Si se deja "gemini", Gemini es el principal y, cuando se agotan los tokens o
# falla, el backend cae automáticamente a modelos GRATUITOS de OpenRouter.
AI_PROVIDER="gemini"

# OPENROUTER_API_KEY: obligatoria si AI_PROVIDER="openrouter", si un request
# envía provider="openrouter" o para el fallback gratuito cuando Gemini se agota.
# Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: modelo por defecto en OpenRouter (alias versionados con "~" soportados).
# Se usa cuando AI_PROVIDER="openrouter" o provider="openrouter".
OPENROUTER_MODEL="~openai/gpt-latest"

# OPENROUTER_FALLBACK_MODEL: (opcional) primer modelo del fallback gratuito cuando
# Gemini se agota. Si se omite, se prueban en orden:
#   openrouter/free  (router automático al mejor modelo gratuito disponible)
#   google/gemma-4-31b-it:free
#   openai/gpt-oss-20b:free
#   nvidia/nemotron-3-super-120b-a12b:free
#   nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_FALLBACK_MODEL=""

# OPENROUTER_TRANSCRIBE_MODEL: modelo con soporte de AUDIO para notas de voz.
# "~openai/gpt-latest" y los modelos gratuitos no aceptan audio. Usa uno como
# "openai/gpt-4o-audio-preview".
OPENROUTER_TRANSCRIBE_MODEL="openai/gpt-4o-audio-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
