# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter (alternativa seleccionable a Gemini)
# AI_PROVIDER: proveedor de IA por defecto. Valores: "gemini" | "openrouter"
AI_PROVIDER="gemini"

# OPENROUTER_API_KEY: obligatoria si AI_PROVIDER="openrouter" o si un request
# envía provider="openrouter". Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: modelo por defecto en OpenRouter (alias versionados con "~" soportados)
OPENROUTER_MODEL="~openai/gpt-latest"

# OPENROUTER_TRANSCRIBE_MODEL: modelo con soporte de AUDIO para notas de voz.
# "~openai/gpt-latest" no acepta audio. Usa uno como "openai/gpt-4o-audio-preview".
OPENROUTER_TRANSCRIBE_MODEL="openai/gpt-4o-audio-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
