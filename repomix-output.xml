                  >
                    <Mic className="w-4 h-4 text-emerald-400" />
                    <span>{newAudioUrl ? '✓ Nota de Voz Adjunta' : '🎙️ Adjuntar Nota de Voz'}</span>
                  </button>

                  <button
                    type="button"
