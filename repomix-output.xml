                              </button>
                              <div>
                                <p className="font-serif font-bold text-xs text-white">
                                  Voz original de Mamá
                                </p>
                                <p className="text-[10px] text-amber-200 font-mono">
                                  Duración: {Math.floor(note.durationSeconds / 60)}m {note.durationSeconds % 60}s
